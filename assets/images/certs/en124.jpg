<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <rect width="800" height="600" fill="#1a1a2e"/>
  <!-- Certificate icon background -->
  <g transform="translate(400,250)" fill="none" stroke="#FF6B1A" stroke-width="3" opacity="0.15">
    <rect x="-50" y="-60" width="100" height="120" rx="8"/>
    <rect x="-40" y="-50" width="80" height="40" rx="4"/>
    <line x1="-30" y1="10" x2="30" y2="10"/>
    <line x1="-30" y1="25" x2="30" y2="25"/>
    <line x1="-30" y1="40" x2="20" y2="40"/>
    <circle cx="0" cy="-50" r="15" fill="#FF6B1A" fill-opacity="0.15"/>
  </g>
  <rect x="300" y="280" width="200" height="3" fill="#FF6B1A" rx="1.5"/>
  <text x="400" y="310" font-family="Arial, sans-serif" font-size="22" fill="#ffffff" text-anchor="middle" font-weight="bold">EN 124 Certification</text>
  <text x="400" y="340" font-family="Arial, sans-serif" font-size="14" fill="#888899" text-anchor="middle">ACONCN</text>
</svg>